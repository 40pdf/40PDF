# 40PDF - clean URLs (no .html, no ?query) for Apache / LiteSpeed (cPanel hosting)
Options -MultiViews -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) one canonical host: https + no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://40pdf.com%{REQUEST_URI} [L,R=301]

# 2) old links like /tool.html?t=merge-pdf and /blog.html?p=... -> clean URLs
RewriteCond %{QUERY_STRING} (^|&)t=remove-pdf-pages(&|$)
RewriteRule ^tool\.html$ /remove-pages? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)t=extract-pdf-pages(&|$)
RewriteRule ^tool\.html$ /extract-pages? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)t=duplicate-pdf-pages(&|$)
RewriteRule ^tool\.html$ /duplicate-pages? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)t=pdf-metadata(&|$)
RewriteRule ^tool\.html$ /pdf-info? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)t=add-watermark(&|$)
RewriteRule ^tool\.html$ /watermark-pdf? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)t=add-page-numbers(&|$)
RewriteRule ^tool\.html$ /page-numbers? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)t=([a-z0-9-]+)(&|$)
RewriteRule ^tool\.html$ /%2? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=how-to-compress-pdf-without-losing-quality(&|$)
RewriteRule ^blog\.html$ /blog/compress-pdf-without-losing-quality? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=how-to-merge-pdf-files(&|$)
RewriteRule ^blog\.html$ /blog/how-to-merge-pdf-files? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=how-to-sign-a-pdf-without-printing(&|$)
RewriteRule ^blog\.html$ /blog/sign-pdf-without-printing? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=convert-photos-to-pdf-on-your-phone(&|$)
RewriteRule ^blog\.html$ /blog/photos-to-pdf-on-your-phone? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=how-to-extract-text-from-a-pdf(&|$)
RewriteRule ^blog\.html$ /blog/extract-text-from-pdf? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=how-to-remove-reorder-rotate-pdf-pages(&|$)
RewriteRule ^blog\.html$ /blog/remove-reorder-rotate-pdf-pages? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=([a-z0-9-]+)(&|$)
RewriteRule ^blog\.html$ /blog/%2? [R=301,L]

# 3) /name.html -> /name  (and /index.html -> /)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4) strip trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5) serve /name from name.html
RewriteRule ^blog/?$ /blog.html [L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
